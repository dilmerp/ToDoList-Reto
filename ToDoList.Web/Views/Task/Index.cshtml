@model IEnumerable<ToDoList.Entities.TaskItem>

@{
    ViewBag.Title = "Listado de Tareas";
}

<style>
    .btn-action-fixed {
        width: 140px;
        display: inline-block;
        text-align: center;
    }
</style>

<div class="row mt-4">
    <div class="col-md-12">
        <h2>Listado de Tareas</h2>
        <hr />

        <div class="d-flex justify-content-between align-items-center mb-3">
            <p class="mb-0">
                @Html.ActionLink("Crear Nueva Tarea", "Create", "Task", null, new { @class = "btn btn-primary" })
            </p>

            <div class="btn-group" role="group" aria-label="Filtros de Tareas">
                @Html.ActionLink("Todas", "Index", new { filter = "all" }, new { @class = ViewBag.CurrentFilter == "all" ? "btn btn-dark" : "btn btn-outline-dark" })
                @Html.ActionLink("Pendientes", "Index", new { filter = "pending" }, new { @class = ViewBag.CurrentFilter == "pending" ? "btn btn-warning" : "btn btn-outline-warning" })
                @Html.ActionLink("Completadas", "Index", new { filter = "completed" }, new { @class = ViewBag.CurrentFilter == "completed" ? "btn btn-success" : "btn btn-outline-success" })
            </div>
        </div>

        <table class="table table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th>Fecha de Creación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Title</strong></td>
                            <td>@item.Description</td>
                            <td>
                                @if (item.IsCompleted)
                                {
                                    <span class="badge" style="background-color: #28a745; color: white; padding: 5px 10px;">Completada</span>
                                }
                                else
                                {
                                    <span class="badge" style="background-color: #ffc107; color: black; padding: 5px 10px;">Pendiente</span>
                                }
                            </td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @using (Html.BeginForm("ToggleStatus", "Task", new { id = item.Id }, FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    <button type="submit" class="btn btn-sm @(item.IsCompleted ? "btn-warning" : "btn-success") btn-action-fixed">
                                        @(item.IsCompleted ? "Marcar Pendiente" : "Completar")
                                    </button>
                                }

                                @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-info btn-action-fixed" })

                                @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-danger btn-action-fixed" })
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No hay tareas registradas. ¡Crea la primera!</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>