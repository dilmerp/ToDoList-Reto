@{
    ViewBag.Title = "Inicio";
}

<div class="row mt-5">
    <div class="col-md-10 offset-md-1">
        <div class="p-5 text-center bg-light rounded shadow-sm" style="border: 1px solid #e3e6f0;">
            <h1 class="display-4 text-primary font-weight-bold">Gestor de Tareas</h1>
            <p class="lead mt-3">
                Plataforma empresarial para el seguimiento y control de actividades.
            </p>
            <hr class="my-4" style="width: 50%;">
            <p class="text-muted">
                Construida aplicando el patrón Repositorio y estrategias de persistencia híbrida (Caché + SQL Server).
            </p>
            <div class="mt-4">
                <a class="btn btn-primary btn-lg" href="@Url.Action("Index", "Task")" role="button">
                    Ir a Mis Tareas <i class="fas fa-arrow-right ml-2"></i>
                </a>
            </div>
        </div>
    </div>
</div>